{
	"name": "@makigas/genshi-svelte",
	"description": "The Svelte Components required to integrate Genshi into a Svelte application",
	"version": "1.0.0-alpha.0",
	"license": "LGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/makigas/genshi-svelte.git"
	},
	"author": {
		"name": "Dani Rodríguez",
		"email": "dani@danirod.es"
	},
	"bugs": {
		"url": "https://github.com/makigas/genshi-svelte/issues"
	},
	"homepage": "https://makigas.github.io/genshi-svelte",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"src/doc/genshi*.png"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"@fontsource/montserrat": "^5.2.5",
		"@lucide/svelte": "^0.511.0",
		"@makigas/genshi": "1.0.0-alpha.1",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@fontsource/montserrat": "^5.2.5",
		"@lucide/svelte": "^0.511.0",
		"@makigas/genshi": "1.0.0-alpha.1",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"mdsvex": "^0.12.3",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"publint": "^0.3.2",
		"shiki": "^3.4.2",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^6.2.6"
	},
	"keywords": [
		"svelte",
		"genshi",
		"design",
		"css",
		"components"
	]
}
